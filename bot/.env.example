# ── Arbitrum Sepolia RPC (required) ────────────────────────────────────────
# Any JSON-RPC endpoint on chainId 421614 (Alchemy, Infura, public, etc.)
ARBITRUM_SEPOLIA_RPC=

# ── Twitter / X API credentials (required for posting) ─────────────────────
# Create a project + app at https://developer.twitter.com with
# user-context OAuth 1.0a "Read and Write" permissions.
# These four values are needed for twitter-api-v2 to post a tweet.
# Not required for `npm run dry-run`.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
