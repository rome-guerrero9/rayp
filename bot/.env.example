# ── Arbitrum Sepolia RPC (required) ────────────────────────────────────────
# Any JSON-RPC endpoint on chainId 421614 (Alchemy, Infura, public, etc.)
ARBITRUM_SEPOLIA_RPC=

# ── Bluesky credentials (required for posting) ─────────────────────────────
# 1. Sign in at https://bsky.app
# 2. Settings → Privacy and security → App passwords → Add app password
# 3. Identifier = your full handle (e.g. rayp.bsky.social or a custom domain).
#    App password = the generated string (NOT your main account password).
# Not required for `npm run dry-run`.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
